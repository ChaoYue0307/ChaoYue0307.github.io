{
  "name": "scifi-idea-atlas",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "description": "A source-linked, cross-media atlas of science-fiction ideas.",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "build": "node scripts/build-static.mjs",
    "check:build": "node scripts/build-static.mjs --check",
    "test:browser": "node qa/browser-checks.mjs",
    "serve": "python3 -m http.server 4173"
  },
  "devDependencies": {
    "axe-core": "4.14.1",
    "playwright": "1.65.1"
  },
  "engines": { "node": ">=22" }
}
